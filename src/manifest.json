{
  "name": "Research Assistant",
  "version": "1.0.0",
  "description": "AI-powered research assistant for analyzing web content",
  "manifest_version": 3,
  "action": {},
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {}
} 