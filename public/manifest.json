{
  "manifest_version": 3,
  "name": "Research Assistant",
  "version": "2.0.0",
  "description": "AI-powered research tool. Analyze any webpage, extract key insights, and build your personal knowledge base.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.chrome.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/icons/*",
        "fonts/*.ttf"
      ],
      "extension_ids": ["*"],
      "matches": []
    }
  ]
}