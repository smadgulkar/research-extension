{
  "manifest_version": 3,
  "name": "Research Assistant",
  "version": "1.0.0",
  "description": "AI-powered research assistant",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.chrome.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/icons/*"],
      "extension_ids": ["*"],
      "matches": []
    }
  ]
}