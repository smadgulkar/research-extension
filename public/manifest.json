{
  "manifest_version": 3,
  "name": "Mindstack – AI knowledge base & summarizer",
  "version": "2.1.0",
  "description": "Turn what you read into a searchable AI knowledge base. Summaries & Q&A via GPT, Claude or Gemini. Export to Obsidian & Notion.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://api.notion.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Mindstack"
  },
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current page to Mindstack"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.chrome.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/icons/*",
        "fonts/*.ttf"
      ],
      "extension_ids": [
        "*"
      ],
      "matches": []
    }
  ],
  "short_name": "Mindstack"
}
