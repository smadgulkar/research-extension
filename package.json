{
  "name": "research-extension",
  "version": "2.1.0",
  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production TARGET=chrome webpack --mode production",
    "build:firefox": "cross-env NODE_ENV=production TARGET=firefox webpack --mode production",
    "build:e2e": "cross-env NODE_ENV=production E2E=1 webpack --mode production",
    "build:all": "npm run build && npm run build:firefox",
    "dev": "cross-env NODE_ENV=development webpack --mode development --watch",
    "typecheck": "tsc --noEmit -p .",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --warnings-as-errors=false",
    "test": "npm run test:e2e",
    "test:e2e": "npm run build:e2e && jest --runInBand tests/e2e",
    "verify": "npm run typecheck && npm run build:all && npm run lint:firefox && npm run test:e2e",
    "analyze": "cross-env NODE_ENV=production ANALYZE=true webpack --mode production",
    "release": "node scripts/release.mjs",
    "screenshots": "npm run build:e2e && node scripts/screenshots.js",
    "dashboard": "node dashboard/collect.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "",
  "dependencies": {
    "@types/chrome": "^0.0.290",
    "@types/lodash": "^4.17.14",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dexie": "^4.0.10",
    "lodash": "^4.17.21",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-feather": "^2.0.10",
    "tailwindcss": "^3.4.17",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "chrome-webstore-upload-cli": "^4.0.2",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "fs-extra": "^11.2.0",
    "jest": "^29.7.0",
    "postcss-loader": "^8.1.1",
    "puppeteer": "^22.0.0",
    "rimraf": "^5.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "web-ext": "^10.8.0",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
